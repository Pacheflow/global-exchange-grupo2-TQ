upstream global_exchange_web {
    server web:8000;
}

upstream global_exchange_keycloak {
    server keycloak:8080;
}

server {
    listen 8080 default_server;
    server_name ${NGINX_APP_HOST};
    client_max_body_size 10m;

    location = /nginx-health {
        access_log off;
        return 200 'ok\n';
        add_header Content-Type text/plain;
    }

    location / {
        proxy_pass http://global_exchange_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port ${NGINX_PUBLIC_HTTP_PORT};
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}

server {
    listen 8080;
    server_name ${NGINX_KEYCLOAK_HOST};

    location / {
        proxy_pass http://global_exchange_keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port ${NGINX_PUBLIC_HTTP_PORT};
        proxy_set_header Connection "";
        proxy_read_timeout 90s;
    }
}

# Modo demostración por IP: Keycloak usa el segundo puerto público, pero sigue
# siendo accesible exclusivamente a través de Nginx.
server {
    listen 8081 default_server;
    server_name _;

    location / {
        proxy_pass http://global_exchange_keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port ${NGINX_KEYCLOAK_PUBLIC_PORT};
        proxy_set_header Connection "";
        proxy_read_timeout 90s;
    }
}
