# Copiar como .env.production y sustituir cada valor REEMPLAZAR_* o CAMBIAR_*.
# Este archivo no contiene una IP, dominio, certificado ni secreto real.

# PostgreSQL (solo red interna de Compose)
DB_NAME=global_exchange_prod
DB_USER=global_exchange_prod
DB_PASSWORD=CAMBIAR_PASSWORD_POSTGRES
DB_HOST=postgres
DB_PORT=5432

# Entrada pública Nginx. Para la demo HTTP, ambos hosts pueden ser la IP de la VM.
NGINX_TLS_ENABLED=false
NGINX_APP_HOST=REEMPLAZAR_HOST_O_IP_VM
NGINX_KEYCLOAK_HOST=REEMPLAZAR_HOST_KEYCLOAK_O_IP_VM
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_KEYCLOAK_PORT=8080

# Django
DJANGO_SECRET_KEY=CAMBIAR_SECRET_KEY_ALEATORIA
DJANGO_ALLOWED_HOSTS=REEMPLAZAR_HOST_O_IP_VM
DJANGO_CSRF_TRUSTED_ORIGINS=http://REEMPLAZAR_HOST_O_IP_VM
DJANGO_LOG_LEVEL=INFO
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# Keycloak. La URL interna permanece fija en http://keycloak:8080 dentro de Compose.
KEYCLOAK_ADMIN=REEMPLAZAR_ADMIN_KEYCLOAK
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN_KEYCLOAK
KEYCLOAK_ADMIN_CLIENT_ID=global-exchange-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=CAMBIAR_SECRET_CLIENTE_ADMIN
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://REEMPLAZAR_HOST_O_IP_VM:8080
KEYCLOAK_REALM=global-exchange
KEYCLOAK_CLIENT_ID=global-exchange-web
KEYCLOAK_EXPECTED_ISSUER=http://REEMPLAZAR_HOST_O_IP_VM:8080/realms/global-exchange

# URLs públicas OIDC
BACKEND_PUBLIC_URL=http://REEMPLAZAR_HOST_O_IP_VM
OIDC_CALLBACK_URL=http://REEMPLAZAR_HOST_O_IP_VM/callback/
OIDC_FLOW_MAX_AGE_SECONDS=600
OIDC_LOGIN_SUCCESS_URL=
OIDC_REGISTRATION_SUCCESS_URL=
OIDC_ERROR_URL=

# Cookies
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false

# Correo. Mailpit solo existe al iniciar Compose con --profile demo.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=REEMPLAZAR_REMITENTE
MAILPIT_PORT=8025

# HU-28 continúa en TEST incluso en este despliegue. Clave fuera de Git.
STRIPE_SECRET_KEY=
STRIPE_TIMEOUT_SECONDS=5

# Factura Segura TEST. Token ESI y RUC se proporcionan fuera de Git.
FACTURA_SEGURA_API_URL=https://apitest.facturasegura.com.py/misife00/v1/esi
FACTURA_SEGURA_TOKEN=
FACTURA_SEGURA_RUC=
FACTURA_SEGURA_TIMEOUT_SECONDS=30
FACTURA_SEGURA_MAX_DOWNLOAD_BYTES=15728640
# HU-29: completar después de implementar/validar el contrato fiscal del emisor.
FACTURACION_CONTRATO=facturacion.contracts.factura_segura_test.ContratoFacturaSeguraTest
FACTURA_EMISOR_DV=3
FACTURA_EMISOR_TIPO_CONTRIBUYENTE=1
FACTURA_EMISOR_NOMBRE=GLOBAL EXCHANGE TEST
FACTURA_EMISOR_DIRECCION=ASUNCION
FACTURA_EMISOR_NUMERO_CASA=0
FACTURA_EMISOR_DEPARTAMENTO_CODIGO=1
FACTURA_EMISOR_DEPARTAMENTO=CAPITAL
FACTURA_EMISOR_CIUDAD_CODIGO=1
FACTURA_EMISOR_CIUDAD=ASUNCION (DISTRITO)
FACTURA_EMISOR_TELEFONO=(021)5887000
FACTURA_EMISOR_EMAIL=axeleliezer7@fpuna.edu.py
FACTURA_EMISOR_ACTIVIDAD_CODIGO=64990
FACTURA_EMISOR_ACTIVIDAD_DESCRIPCION=OTRAS ACTIVIDADES DE SERVICIOS FINANCIEROS N.C.P.
FACTURA_TIMBRADO=02595733
FACTURA_TIMBRADO_FECHA_INICIO=2025-03-27
FACTURA_ESTABLECIMIENTO=001
FACTURA_PUNTO_EXPEDICION=003
FACTURA_NUMERO_DESDE=338
FACTURA_NUMERO_HASTA=349
FACTURA_TIPO_IMPUESTO=1
FACTURA_AFECTACION_IVA=1
FACTURA_PROPORCION_IVA=100
FACTURA_TASA_IVA=10

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Para HTTPS con dominios, instalar fullchain.pem y privkey.pem en
# docker/nginx/certs/ (ignorados por Git) y cambiar coherentemente:
# NGINX_TLS_ENABLED=true
# NGINX_APP_HOST=REEMPLAZAR_DOMINIO_APP
# NGINX_KEYCLOAK_HOST=REEMPLAZAR_DOMINIO_KEYCLOAK
# DJANGO_ALLOWED_HOSTS=REEMPLAZAR_DOMINIO_APP
# DJANGO_CSRF_TRUSTED_ORIGINS=https://REEMPLAZAR_DOMINIO_APP
# DJANGO_BEHIND_HTTPS_PROXY=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# BACKEND_PUBLIC_URL=https://REEMPLAZAR_DOMINIO_APP
# OIDC_CALLBACK_URL=https://REEMPLAZAR_DOMINIO_APP/callback/
# KEYCLOAK_PUBLIC_URL=https://REEMPLAZAR_DOMINIO_KEYCLOAK
# KEYCLOAK_EXPECTED_ISSUER=https://REEMPLAZAR_DOMINIO_KEYCLOAK/realms/global-exchange
