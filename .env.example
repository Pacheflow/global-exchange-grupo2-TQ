# PostgreSQL
DB_NAME=global_exchange
DB_USER=global_exchange
DB_PASSWORD=global_exchange_dev
DB_HOST=postgres
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=CAMBIAR_POR_UN_VALOR_ALEATORIO
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8000

# Keycloak - administrador local
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
KEYCLOAK_PORT=8080

# Keycloak - configuracion compartida con Django
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=global-exchange
KEYCLOAK_CLIENT_ID=global-exchange-web
KEYCLOAK_EXPECTED_ISSUER=http://localhost:8080/realms/global-exchange

# Backend y flujo OIDC
BACKEND_PUBLIC_URL=http://localhost:8000
OIDC_CALLBACK_URL=http://localhost:8000/callback/
OIDC_FLOW_MAX_AGE_SECONDS=600

# Frontend separado (las redirecciones quedan vacías mientras no exista)
FRONTEND_BASE_URL=http://localhost:3000
OIDC_LOGIN_SUCCESS_URL=
OIDC_REGISTRATION_SUCCESS_URL=

# Cliente técnico del backend para administrar usuarios y roles
KEYCLOAK_ADMIN_CLIENT_ID=global-exchange-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=global-exchange-admin-dev-secret
OIDC_ERROR_URL=

# Cookies (usar true/None sobre HTTPS si frontend y backend son cross-site)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false

# Tasas de referencia (HU-17)
TASAS_PROVIDER_URL=https://open.er-api.com/v6/latest/__BASE__
TASAS_PROVIDER_API_KEY=
TASAS_PROVIDER_TIMEOUT=5
TASAS_PROVIDER_NAME=ExchangeRate-API
TASAS_BASE_CURRENCY=USD
TASAS_VALIDITY_SECONDS=86400
